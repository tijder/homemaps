# Eén hostnaam voor alles: de app, en daarachter routing, zoeken en tegels. De
# browser haalt zo alles van dezelfde origin (geen CORS) en de chart heeft geen
# pad-herschrijving van een Ingress-controller of Gateway nodig.

# De backends worden pas bij een verzoek opgezocht (proxy_pass met een variabele):
# een onderdeel dat in de chart uit staat mag nginx niet bij het starten vellen.
resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;

map $http_upgrade $verbinding { default upgrade; "" close; }

server {
    # Dual-stack: probes en de gateway komen hier over IPv6 binnen.
    listen 8080;
    listen [::]:8080;
    server_name _;
    root /usr/share/nginx/html;

    # maplibre-gl-js wordt als ES-module geladen; met een ander MIME-type weigert
    # de browser hem. Oudere mime.types kennen .mjs niet.
    types { text/javascript mjs; }
    include /etc/nginx/mime.types;

    gzip on;
    gzip_types text/javascript application/javascript application/json application/wasm text/css application/x-protobuf;

    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    location /valhalla/ {
        set $valhalla ${VALHALLA_UPSTREAM};
        rewrite ^/valhalla/(.*)$ /$1 break;
        proxy_pass $valhalla;
        proxy_read_timeout 60s;
    }

    # Photon: /geocode -> /api, /geocode/structured -> /structured, /geocode/reverse -> /reverse
    location = /geocode {
        set $photon ${PHOTON_UPSTREAM};
        rewrite ^ /api break;
        proxy_pass $photon;
    }
    location /geocode/ {
        set $photon ${PHOTON_UPSTREAM};
        rewrite ^/geocode/(.*)$ /$1 break;
        proxy_pass $photon;
    }

    # De verkeerslaag die de importer (naast Valhalla) elke ronde maakt. Hij pakt
    # zelf in; nginx geeft Content-Encoding gewoon door.
    location = /verkeer {
        set $verkeer ${VERKEER_UPSTREAM};
        rewrite ^ /verkeer.geojson break;
        proxy_pass $verkeer;
    }

    # Geplande afsluitingen van de komende week, voor "later vertrekken".
    location = /verkeer-gepland {
        set $verkeer ${VERKEER_UPSTREAM};
        rewrite ^ /verkeer-gepland.geojson break;
        proxy_pass $verkeer;
    }

    # Maximumsnelheden naar tijdstip (OSM maxspeed:conditional), per OSM-way.
    location = /snelheid-tijden {
        set $verkeer ${VERKEER_UPSTREAM};
        rewrite ^ /snelheid-tijden.json break;
        proxy_pass $verkeer;
    }

    # tileserver-gl bouwt de URL's in style.json en de TileJSON uit het verzoek:
    # Host, X-Forwarded-Proto en -- voor dit pad -- X-Forwarded-Path. Zo werkt één
    # installatie onder meerdere hostnamen (intern en publiek) zonder vaste
    # --public_url. Een proxy_set_header in een location vervangt de hele geërfde
    # set, dus Host en de rest staan hier opnieuw.
    location /tiles/ {
        set $tiles ${TILES_UPSTREAM};
        rewrite ^/tiles/(.*)$ /$1 break;
        proxy_pass $tiles;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Path /tiles;
    }

    # Runtime-config van de app; de chart mount hier een ConfigMap overheen.
    location = /config.json {
        add_header Cache-Control "no-cache";
        try_files /config/config.json /config.json =404;
    }

    # Wat bij elke release van naam gelijk blijft mag de browser niet vasthouden.
    location ~ ^/(index\.html|flutter_bootstrap\.js|flutter_service_worker\.js|manifest\.json|version\.json)$ {
        add_header Cache-Control "no-cache";
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
