# One hostname for everything: the app, and behind it routing, search and tiles.
# That way the browser fetches everything from the same origin (no CORS) and the
# chart needs no path rewriting from an Ingress controller or Gateway.

# The backends are only looked up on a request (proxy_pass with a variable):
# a component that is disabled in the chart must not bring nginx down at startup.
resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;

map $http_upgrade $connection_upgrade { default upgrade; "" close; }

server {
    # Dual-stack: probes and the gateway come in here over IPv6.
    listen 8080;
    listen [::]:8080;
    server_name _;
    root /usr/share/nginx/html;

    # maplibre-gl-js is loaded as an ES module; with another MIME type the
    # browser refuses it. Older mime.types do not know .mjs.
    types { text/javascript mjs; }
    include /etc/nginx/mime.types;

    gzip on;
    gzip_types text/javascript application/javascript application/json application/wasm text/css application/x-protobuf;

    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    location /valhalla/ {
        set $valhalla ${VALHALLA_UPSTREAM};
        rewrite ^/valhalla/(.*)$ /$1 break;
        proxy_pass $valhalla;
        proxy_read_timeout 60s;
    }

    # Photon: /geocode -> /api, /geocode/structured -> /structured, /geocode/reverse -> /reverse
    location = /geocode {
        set $photon ${PHOTON_UPSTREAM};
        rewrite ^ /api break;
        proxy_pass $photon;
    }
    location /geocode/ {
        set $photon ${PHOTON_UPSTREAM};
        rewrite ^/geocode/(.*)$ /$1 break;
        proxy_pass $photon;
    }

    # The traffic layer the importer (next to Valhalla) builds every cycle. It
    # compresses it itself; nginx just passes Content-Encoding through.
    location = /traffic {
        set $traffic ${TRAFFIC_UPSTREAM};
        rewrite ^ /traffic.geojson break;
        proxy_pass $traffic;
    }

    # Planned closures for the coming week, for "leave later".
    location = /traffic-planned {
        set $traffic ${TRAFFIC_UPSTREAM};
        rewrite ^ /traffic-planned.geojson break;
        proxy_pass $traffic;
    }

    # Speed limits by time of day (OSM maxspeed:conditional), per OSM way.
    location = /conditional-speeds {
        set $traffic ${TRAFFIC_UPSTREAM};
        rewrite ^ /conditional-speeds.json break;
        proxy_pass $traffic;
    }

    # tileserver-gl builds the URLs in style.json and the TileJSON from the request:
    # Host, X-Forwarded-Proto and -- for this path -- X-Forwarded-Path. That way one
    # installation works under several hostnames (internal and public) without a
    # fixed --public_url. A proxy_set_header in a location replaces the whole
    # inherited set, so Host and the rest are repeated here.
    location /tiles/ {
        set $tiles ${TILES_UPSTREAM};
        rewrite ^/tiles/(.*)$ /$1 break;
        proxy_pass $tiles;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Path /tiles;
    }

    # The app's runtime config; the chart mounts a ConfigMap over it.
    location = /config.json {
        add_header Cache-Control "no-cache";
        try_files /config/config.json /config.json =404;
    }

    # Whatever keeps the same name across releases must not be cached by the browser.
    location ~ ^/(index\.html|flutter_bootstrap\.js|flutter_service_worker\.js|manifest\.json|version\.json)$ {
        add_header Cache-Control "no-cache";
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
