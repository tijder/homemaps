{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["region", "storage", "web", "tiles", "valhalla", "photon"],
  "properties": {
    "clusterDomain": { "type": "string", "minLength": 1 },
    "region": {
      "type": "object",
      "required": ["name", "pbfUrl"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "pbfUrl": { "type": "string", "pattern": "^https?://" },
        "bbox": { "type": "string", "pattern": "^$|^-?[0-9.]+,-?[0-9.]+,-?[0-9.]+,-?[0-9.]+$" }
      }
    },
    "storage": {
      "type": "object",
      "properties": {
        "storageClassName": { "type": "string" },
        "accessMode": { "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadWriteOncePod"] }
      }
    },
    "web": { "type": "object", "required": ["enabled"], "properties": { "enabled": { "type": "boolean" }, "config": { "type": "object" } } },
    "tiles": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "publicUrl": { "type": "string", "pattern": "^$|^https?://.*/$" },
        "styles": { "type": "array", "minItems": 1, "items": { "enum": ["osm-bright", "positron", "dark-matter"] } },
        "planetiler": {
          "type": "object",
          "properties": {
            "world": {
              "type": "object",
              "properties": { "enabled": { "type": "boolean" }, "maxzoom": { "type": "integer", "minimum": 0, "maximum": 10 } }
            }
          }
        }
      }
    },
    "valhalla": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "threads": { "type": "integer", "minimum": 1 },
        "traffic": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "intervalSeconds": { "type": "integer", "minimum": 60 },
            "closures": { "type": "boolean" },
            "msiSeconds": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "photon": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "dbUrl": { "type": "string", "pattern": "^https?://" },
        "heap": { "type": "string", "pattern": "^[0-9]+[mMgG]$" },
        "ipFamilies": { "type": "array", "items": { "enum": ["IPv4", "IPv6"] } }
      }
    },
    "httpRoute": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "hostnames": { "type": "array" }, "parentRefs": { "type": "array" } } },
    "ingress": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "hosts": { "type": "array" } } }
  }
}
