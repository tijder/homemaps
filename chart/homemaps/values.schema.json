{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "region",
    "storage",
    "web",
    "tiles",
    "valhalla",
    "photon"
  ],
  "properties": {
    "clusterDomain": {
      "type": "string",
      "minLength": 1
    },
    "region": {
      "type": "object",
      "required": [
        "name",
        "pbfUrl"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "pbfUrl": {
          "type": "string",
          "pattern": "^https?://"
        },
        "bbox": {
          "type": "string",
          "pattern": "^$|^-?[0-9.]+,-?[0-9.]+,-?[0-9.]+,-?[0-9.]+$"
        },
        "overpassUrl": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "properties": {
        "storageClassName": {
          "type": "string"
        },
        "accessMode": {
          "enum": [
            "ReadWriteOnce",
            "ReadWriteMany"
          ]
        }
      },
      "additionalProperties": false
    },
    "web": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "config": {
          "type": "object"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object"
        },
        "rateLimit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "trustedProxies": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9A-Fa-f:.]+(/[0-9]+)?$"
              }
            },
            "requestsPerSecond": {
              "type": "integer",
              "minimum": 1
            },
            "burst": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "additionalProperties": false
    },
    "website": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "siteUrl": {
          "type": "string",
          "pattern": "^$|^https?://[^/]+(/.*[^/])?$"
        },
        "config": {
          "type": "object",
          "properties": {
            "appUrl": {
              "type": "string",
              "pattern": "^$|^https?://"
            },
            "testflightUrl": {
              "type": "string",
              "pattern": "^$|^https?://"
            },
            "playStoreUrl": {
              "type": "string",
              "pattern": "^$|^https?://"
            },
            "appStoreUrl": {
              "type": "string",
              "pattern": "^$|^https?://"
            }
          },
          "additionalProperties": false
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "tiles": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "publicUrl": {
          "type": "string",
          "pattern": "^$|^https?://.*/$"
        },
        "styles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "osm-bright",
              "positron",
              "dark-matter"
            ]
          }
        },
        "planetiler": {
          "type": "object",
          "properties": {
            "world": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "maxzoom": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10
                }
              },
              "additionalProperties": false
            },
            "image": {
              "type": "object",
              "properties": {
                "repository": {
                  "type": "string"
                },
                "tag": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "schedule": {
              "type": "string"
            },
            "timeZone": {
              "type": "string"
            },
            "scratchSize": {
              "type": "string"
            },
            "javaOpts": {
              "type": "string"
            },
            "extraArgs": {
              "type": "array"
            },
            "resources": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "extraAllowedHosts": {
          "type": "array"
        },
        "size": {
          "type": "string"
        },
        "resources": {
          "type": "object"
        },
        "rendererPool": {
          "type": "object",
          "properties": {
            "min": {
              "type": "array"
            },
            "max": {
              "type": "array"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "valhalla": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "threads": {
          "type": "integer",
          "minimum": 1
        },
        "traffic": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "intervalSeconds": {
              "type": "integer",
              "minimum": 60
            },
            "closures": {
              "type": "boolean"
            },
            "msiSeconds": {
              "type": "integer",
              "minimum": 0
            },
            "incidents": {
              "type": "boolean"
            },
            "bridges": {
              "type": "boolean"
            },
            "speedLimits": {
              "type": "boolean"
            },
            "planningSeconds": {
              "type": "integer",
              "minimum": 0
            },
            "image": {
              "type": "object",
              "properties": {
                "repository": {
                  "type": "string"
                },
                "tag": {
                  "type": "string"
                },
                "pullPolicy": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "ndwUrl": {
              "type": "string"
            },
            "resources": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "size": {
          "type": "string"
        },
        "resources": {
          "type": "object"
        },
        "build": {
          "type": "object",
          "properties": {
            "schedule": {
              "type": "string"
            },
            "timeZone": {
              "type": "string"
            },
            "threads": {
              "type": "integer"
            },
            "resources": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "photon": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "dbUrl": {
          "type": "string",
          "pattern": "^https?://"
        },
        "heap": {
          "type": "string",
          "pattern": "^[0-9]+[mMgG]$"
        },
        "ipFamilies": {
          "type": "array",
          "items": {
            "enum": [
              "IPv4",
              "IPv6"
            ]
          }
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "size": {
          "type": "string"
        },
        "runAsUser": {
          "type": "integer"
        },
        "resources": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hostnames": {
          "type": "array"
        },
        "parentRefs": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hosts": {
          "type": "array"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "tls": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "commonLabels": {
      "type": "object"
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "securityContext": {
      "type": "object",
      "properties": {
        "runAsUser": {
          "type": "integer"
        },
        "runAsGroup": {
          "type": "integer"
        },
        "fsGroup": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressNamespaces": {
          "type": "array"
        },
        "monitoringNamespace": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "prometheusRule": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "object"
            },
            "maxAgeSeconds": {
              "type": "integer"
            },
            "feedMaxAgeSeconds": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "global": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$comment": "Every object is closed: a misspelled key (valhalla.trafic, networkPolicy.ingressNamespace) is an error instead of a value that is silently ignored. Free-form: resources, labels, annotations, commonLabels, web.config."
}
